POST http://127.0.0.1:8080/api/plants
Content-Type: application/json

# Log Ausgaben!
#  - initial care tasks
#  - setup fee
#  - plant registered
#
# Mit den (asynchronen) Events:
#  - UsageTracker + CareService laufen auf eigenen Threads
#  - 👉 Preis der Entkopplung: Eventual Consistency
#    Der Client hat sein 201 schon, während care_tasks/usage_records
#    noch entstehen
#
# Mit @TransactionalEventListener:
#  => UsageTracker + CareService werden gar nicht mehr ausgeführt
#
# Mit @ApplicationModuleListener (happy path)
#  => Verhalten wie zuvor, asynchron

{
  "location": "Balkon",
  "name": "Cannabis (nur für medizinische Zwecke)",
  "ownerId": "ee3829e4-fe2b-4d03-b2a1-70f1425d8c1c",
  "plantType": "SUMMER_FLOWERS"
}